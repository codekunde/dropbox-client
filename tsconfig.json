{
    "compilerOptions": {
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "./dist",
        "rootDir": "./source",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "resolveJsonModule": true,
        "target": "es2020",
        // TypeScript 6 defaults: strict on, no automatic @types. Keep the previous behaviour.
        "strict": false,
        "types": ["node"]
    },
    "include": [
        "./source/**/*"
    ],
    "exclude":[
        "./node_modules",
        "./dist"
    ]
}
